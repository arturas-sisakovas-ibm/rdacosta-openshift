---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ role_binding_name }}
  namespace: {{ target_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ cluster_role }}
subjects:
{% for namespace in namespaces %}
  - kind: ServiceAccount
    # apiGroup: v1
    name: {{ service_account | default('default') }}
    namespace: {{ namespace }}
{% endfor %}
