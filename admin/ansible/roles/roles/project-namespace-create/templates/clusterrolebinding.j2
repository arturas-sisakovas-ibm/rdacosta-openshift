---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ cluster_role_binding_name }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ cluster_role }}
subjects:
{% for subject in subjects %}
  - apiGroup: rbac.authorization.k8s.io
    kind: {{ subject['kind'] }}
    name: {{ subject['user'] }}
{% endfor %}
