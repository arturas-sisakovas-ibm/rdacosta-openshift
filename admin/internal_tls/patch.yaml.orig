spec:
  template:
    spec:
      containers:
        - name: server
          volumeMounts:
           - name: secret-volume
             mountPath: /etc/pki/nginx/
      volumes:
        - name: secret-volume
          secret:
            defaultMode: 420
            secretName: server-secret
            items:
             - key: tls.crt 
               path: server.crt
             - key: tls.key
               path: private/server.key
