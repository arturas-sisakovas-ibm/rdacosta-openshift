---
apiVersion: velero.io/v1
kind: Backup
metadata:
  name: backup-{{ unix_epoch }}
  namespace: {{ adp_namespace | default('openshift-adp') }}
  labels:
    velero.io/storage-location: oadp-dpa-1
spec:
  includedNamespaces:
    - {{ work_project | default('my-project')}}
  storageLocation: oadp-dpa-1
  snapshotVolumes: true
