apiVersion: v1
kind: Service
metadata:
  name: {{ my_svc | mandatory('You must specify a service name') }}
  namespace: {{ my_namespace | mandatory('You must specify where the service will be created') }}
spec:
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
{% for p in svc_ports %}
  - name: {{ p.name }}
    port: {{ p.port }}
    protocol: TCP
    targetPort: {{ p.port }}
{% endfor %}
  selector:
    kubevirt.io/domain: {{ my_svc | mandatory('You must specify a service name') }}
  sessionAffinity: None
  type: ClusterIP
