apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ my_netpol | default('allow-ingress-to-web') }}
  namespace: {{ my_namespace | mandatory('You must specify a namespace') }}
spec:
  podSelector:
    matchLabels:
      app: {{ my_app_label | default('web') }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              network.openshift.io/policy-group: ingress
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openshift-cnv
{% for namespace in my_allowed_namespace %}
{% if namespace | trim %}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ namespace | trim | to_json | default(omit) }}
{% endif %}
{% endfor %}
      ports:
        - protocol: TCP
          port: {{ my_port | default(80) }}

