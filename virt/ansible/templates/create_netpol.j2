apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ my_netpol | default('allow-ingress-to-web') }}
  namespace: {{ my_namespace | mandatory('You must specify a namespace') }}
spec:
  podSelector:
    matchLabels:
      app: {{ my_app_label | default('web') }}
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              network.openshift.io/policy-group: ingress
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: openshift-cnv
{% for namespace in my_allowed_namespace_list %}
{% set ns = namespace | trim | regex_replace('^- ', '') | regex_replace('^\"|\"$', '') | regex_replace("^'|'$", '') %}
{% if ns %}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ ns | to_json }}
{% endif %}
{% endfor %}
      ports:
        - protocol: TCP
          port: {{ my_port | default(80) }}

