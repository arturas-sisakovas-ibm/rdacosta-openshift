[
  {
    "op": "add",
    "path": "/spec/dataVolumeTemplates/-",
    "value": {
      "metadata": { "name": "{{ my_disk }}" },
      "spec": {
        "source": { "blank": {} },
        "storage": {
          "storageClassName": "{{ my_storageclass }}",
          "accessModes": ["ReadWriteOnce"],
          "resources": { "requests": { "storage": "{{ my_size }}" } }
        }
      }
    }
  },
  {
    "op": "add",
    "path": "/spec/template/spec/domain/devices/disks/-",
    "value": {
      "name": "{{ my_disk }}",
      "disk": { "bus": "scsi" }
    }
  },
  {
    "op": "add",
    "path": "/spec/template/spec/volumes/-",
    "value": {
      "name": "{{ my_disk }}",
      "dataVolume": { "name": "{{ my_disk }}" }
    }
  }
]

